# The landing page and npm test run without credentials.
# Required before using the Supabase utilities: dashboard → Connect → project URL
# and publishable key. Copy this file to .env.local and enter values there only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Use the new sb_publishable_ key format. Secret/service-role keys are forbidden here.
# All NEXT_PUBLIC values are exposed to browsers. RLS, not the key, protects data.
# Required for signup/recovery emails: exact trusted app origin, without a path.
# Match Supabase Auth Site URL. Use HTTPS for a deployed site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Database passwords and CLI tokens belong in CLI prompts / your credential store,
# not in this file. No privileged server key is used by this MVP.

# Vercel: set these three values separately for Preview and Production.
# Use a separate Supabase project for previews. Set the exact HTTPS site origin
# before building; public variables are embedded into the generated client code.
# Run npm run deploy:check before the deployment build.

# Google/Apple client secrets belong in Supabase Auth provider settings only.
# Buttons appear automatically when /auth/v1/settings reports a provider enabled.
# Do not add OAuth provider secrets to NEXT_PUBLIC variables.
